NODE_ENV=development
PORT=8080

# LLM Provider: openai | anthropic | gemini | deepseek | groq | openrouter
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=

# Timeouts and token budget — keeps API costs low during the 60-min test
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=600        # max tokens per /v1/tick composition response
LLM_MAX_TOKENS_REPLY=400  # max tokens per /v1/reply response (shorter = cheaper)
LLM_CALLS_PER_MINUTE=30   # hard cap on LLM calls/min (all providers allow ≥60)

# Team Info
TEAM_NAME=Team Vera
TEAM_MEMBERS=Kartik
CONTACT_EMAIL=kartik@example.com

# Logging
LOG_LEVEL=info
